{
	"name": "svelte-kit-material-ui",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"dev": "npm run prepare && vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "npm run smui-theme-common && npm run smui-theme-light && npm run smui-theme-dark",
		"smui-theme-common": "smui-theme compile static/common.css -i src/theme/common",
		"smui-theme-light": "smui-theme compile static/smui.css -i src/theme",
		"smui-theme-dark": "smui-theme compile static/smui-dark.css -i src/theme/dark"
	},
	"devDependencies": {
		"@smui/button": "^9.0.2",
		"@smui/card": "^9.0.2",
		"@smui/circular-progress": "^9.0.2",
		"@smui/data-table": "^9.0.2",
		"@smui/dialog": "^9.0.2",
		"@smui/drawer": "^9.0.2",
		"@smui/form-field": "^9.0.2",
		"@smui/icon-button": "^9.0.2",
		"@smui/layout-grid": "^9.0.2",
		"@smui/list": "^9.0.2",
		"@smui/snackbar": "^9.0.2",
		"@smui/switch": "^9.0.2",
		"@smui/tab": "^9.0.2",
		"@smui/tab-bar": "^9.0.2",
		"@smui/textfield": "^9.0.2",
		"@smui/top-app-bar": "^9.0.2",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.70.3",
		"smui-theme": "^9.0.3",
		"svelte": "^5.56.10",
		"vite": "^8.2.2"
	},
	"type": "module",
	"overrides": {
		"smui-theme": {
			"yargs": "^18.0.0"
		}
	}
}
